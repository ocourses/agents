*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb
build/

# ── Secrets / environnement local ────────────────────
.env
.env.*
*.local

# ── Divers ────────────────────────────────────────────
*.bak
*.tmp
*.orig
