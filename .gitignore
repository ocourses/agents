# ── macOS ─────────────────────────────────────────────
.DS_Store
._*
.AppleDouble
.LSOverride

# ── Éditeurs / IDE ────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

