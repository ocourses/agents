#!/usr/bin/env bash
# Compile un ou plusieurs documents LaTeX dans le conteneur TeX Live — la MÊME
# image que la CI (latex-pr.yml), pour que « ça compile ici » = « ça compilera
# sur la PR ».
#
#   latex-compile <chemin/doc.tex> [autre.tex ...]
#
# La sortie (PDF, .aux, build/…) va dans un dossier JETABLE hors du dépôt : le
# but est de VÉRIFIER, pas de produire un livrable. Ne commite jamais de PDF.
# Affiche les erreurs filtrées du log ; code de retour != 0 si un document échoue.
set -u

IMAGE="${TEXLIVE_IMAGE:-ghcr.io/xu-cheng/texlive-full:latest}"
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
[ "$#" -gt 0 ] || { echo "usage: latex-compile <doc.tex> [...]" >&2; exit 2; }

out="$(mktemp -d)"; trap 'rm -rf "$out"' EXIT
rc=0
for f in "$@"; do
  path="$f"; [ -f "$path" ] || path="$root/$f"
  if [ ! -f "$path" ]; then
    echo "latex-compile: introuvable : $f" >&2; rc=1; continue
  fi
  rel="$(cd "$(dirname "$path")" && pwd)/$(basename "$path")"; rel="${rel#"$root"/}"
  dir="$(dirname "$rel")"; base="$(basename "$rel")"; stem="${base%.tex}"
  mkdir -p "$out/$dir"

  echo "── latex-compile: $rel"
  # -output-directory hors du dépôt : le tree reste propre. TEXINPUTS des
  # .latexmkrc reste relatif au -w (dossier du doc), les entrées sont trouvées.
  if docker run --rm -v "$root":/w -v "$out":/out -w "/w/$dir" "$IMAGE" \
       latexmk -pdf -interaction=nonstopmode -halt-on-error -file-line-error \
               -output-directory="/out/$dir" -auxdir="/out/$dir" "$base" \
       > "$out/$stem.stdout" 2>&1
  then
    echo "   OK ($stem.pdf produit hors du dépôt — ne pas committer)"
  else
    rc=1
    echo "   ECHEC — premières erreurs :"
    if [ -f "$out/$dir/$stem.log" ]; then
      grep -nE ':[0-9]+:|^!|^l\.[0-9]+|Undefined control|Runaway|Missing|Not in outer|Emergency stop' \
        "$out/$dir/$stem.log" | head -40 | sed 's/^/   /'
    else
      tail -40 "$out/$stem.stdout" | sed 's/^/   /'
    fi
  fi
done
exit "$rc"
